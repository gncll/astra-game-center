{
  "name": "astra-game-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4194",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4194",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:game": "node --test tests/wardenfall/*.cjs",
    "check": "npm run typecheck && npm test && npm run test:game"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
