# Supabase Dashboard > Connect. Use a publishable (or legacy anon) key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Your deployed HTTPS URL. Add /auth/callback to Supabase's allowed redirect URLs.
SITE_URL=http://127.0.0.1:4194

# Server-only Fine Print providers. Do not prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional model override for an available Responses + web_search model.
FINE_PRINT_MODEL=gpt-6-astra
